# Public browser-safe configuration
PUBLIC_APP_ORIGIN=http://localhost:4321
PUBLIC_SUPABASE_URL=https://example.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=example_publishable_key
PUBLIC_SENTRY_DSN=https://examplePublicKey@example.ingest.sentry.io/exampleProjectId

# Server-only Supabase configuration
SUPABASE_URL=https://example.supabase.co
SUPABASE_SECRET_KEY=replace_in_secret_store

# Setup/CI-only Supabase management configuration
SUPABASE_ACCESS_TOKEN=replace_in_secret_store
SUPABASE_DB_PASSWORD=replace_in_secret_store
SUPABASE_PROJECT_REF=example_project_ref

# Cloudflare deployment configuration
CLOUDFLARE_ACCOUNT_ID=example_account_id
CLOUDFLARE_API_TOKEN=replace_in_secret_store

# Server-only observability and provider configuration
SENTRY_AUTH_TOKEN=replace_in_secret_store
RESEND_API_KEY=replace_in_secret_store
STRIPE_SECRET_KEY=replace_in_secret_store
STRIPE_WEBHOOK_SECRET=replace_in_secret_store
