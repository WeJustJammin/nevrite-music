{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wejammin-api",
  "main": "src/runtime-entry.ts",
  "compatibility_date": "2026-08-29",
  "minify": true,
  "limits": { "cpu_ms": 50 },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "vars": {
    "APP_ENVIRONMENT": "production",
    "CLOUDFLARE_PLATFORM_DLQ_ID": "88155985aa0c49caa591b9bf9e6ca937",
  },
  "send_email": [
    {
      "name": "PLATFORM_ALERT_EMAIL",
      "destination_address": "admin.wejammin@gmail.com",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "PLATFORM_JOBS",
        "queue": "platform-jobs",
      },
    ],
    "consumers": [
      {
        "queue": "platform-jobs",
        "max_retries": 3,
        "dead_letter_queue": "platform-jobs-dlq",
      },
    ],
  },
  "triggers": {
    "crons": ["* * * * *"],
  },
  "env": {
    "local": {
      "name": "wejammin-api-local",
      "workers_dev": true,
      "vars": {
        "APP_ENVIRONMENT": "development",
        "APP_RELEASE": "local",
      },
      "queues": {
        "producers": [
          {
            "binding": "PLATFORM_JOBS",
            "queue": "platform-jobs",
            "remote": false,
          },
        ],
        "consumers": [
          {
            "queue": "platform-jobs",
            "max_retries": 3,
            "dead_letter_queue": "platform-jobs-dlq",
          },
        ],
      },
      "triggers": {
        "crons": ["* * * * *"],
      },
    },
    "staging": {
      "name": "wejammin-api-staging",
      "workers_dev": true,
      "limits": { "cpu_ms": 50 },
      "observability": {
        "enabled": true,
        "head_sampling_rate": 0.1,
      },
      "vars": {
        "APP_ENVIRONMENT": "staging",
      },
      "queues": {
        "producers": [
          {
            "binding": "PLATFORM_JOBS",
            "queue": "platform-jobs-staging",
          },
        ],
        "consumers": [
          {
            "queue": "platform-jobs-staging",
            "max_retries": 3,
            "dead_letter_queue": "platform-jobs-staging-dlq",
          },
        ],
      },
      "triggers": {
        "crons": ["* * * * *"],
      },
    },
  },
}
