{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wejammin-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-29",
  "minify": true,
  "workers_dev": false,
  "limits": {
    "cpu_ms": 50,
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
  },
  "vars": {
    "APP_ENVIRONMENT": "production",
    "APP_RELEASE": "local",
  },
  "env": {
    "staging": {
      "name": "wejammin-api-staging",
      "workers_dev": true,
      "limits": {
        "cpu_ms": 50,
      },
      "observability": {
        "enabled": true,
        "head_sampling_rate": 0.1,
      },
      "vars": {
        "APP_ENVIRONMENT": "staging",
        "APP_RELEASE": "local",
      },
    },
  },
}
