{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wejammin-s09-real-web",
  "main": "./content-schema-registry-web.mjs",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"],
    },
  ],
  "workers_dev": false,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "services": [
    {
      "binding": "PLATFORM_API",
      "service": "wejammin-s09-real-api",
    },
  ],
  "observability": {
    "enabled": true,
  },
  "no_bundle": true,
}
