---
import { normalizeSafeReturnPath } from '@wejammin/ui/infrastructure/navigation';
import '@wejammin/ui/styles.css';
import '../../styles/infrastructure.css';

export const prerender = false;

const returnTo = normalizeSafeReturnPath(
  Astro.url.searchParams.get('returnTo'),
);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Sign in to continue to the requested WeJammin workspace."
    />
    <title>Sign in | WeJammin</title>
  </head>
  <body class="infra-page">
    <nav aria-label="Skip navigation">
      <a class="infra-skip-link" href="#main-content">Skip to main content</a>
    </nav>
    <main id="main-content" class="infra-main" tabindex="-1">
      <div class="infra-shell-header">
        <p class="infra-eyebrow">WeJammin account</p>
        <h1 id="page-title" tabindex="-1">Sign in</h1>
        <p>
          Sign in to continue. The requested return target is normalized on the
          server before any redirect.
        </p>
      </div>
      <section class="infra-workbench-header" aria-labelledby="sign-in-heading">
        <h2 id="sign-in-heading">Continue to your workspace</h2>
        <form method="post" action="/auth/sign-in">
          <input type="hidden" name="returnTo" value={returnTo} />
          <button type="submit" name="provider" value="github">
            Continue with GitHub
          </button>
        </form>
        <p class="infra-help">
          Return target: <code>{returnTo}</code>. If authentication expires,
          your unsent local input remains in the current form and is never
          placed in the URL.
        </p>
      </section>
      <p><a href="/">Return to the public shell</a></p>
    </main>
    <script src="../../lib/route-heading-focus.ts"></script>
  </body>
</html>
