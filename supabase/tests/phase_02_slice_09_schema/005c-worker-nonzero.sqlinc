-- A non-zero conditional migration proves the worker hand-off carries the
-- producer's independent transform report into bounded execution.  The
-- worker helpers model two source rows without touching application content;
-- cursor/CAS/count transitions remain the contract under test.
select set_config('request.jwt.claim.role', 'service_role', true);
select set_config('app.cms_rpc', 'true', true);
insert into platform_private.cms_content_type_versions(
  id, owner_id, state, version, content_type_id, version_no, labels,
  workflow_key, workflow_version, source_locale, default_locale,
  default_template_version_id, schema_artifact_id, definition_hash,
  compatibility, dry_run_id, created_by
) values (
  'a9090000-0000-4000-8000-000000000501', (select organization_id from s09_fixture_org),
  -- Version number 50 is reserved for this isolated worker target; the
  -- activation-remediation fixtures use the lower 5-10 range.
  'approved', 1, (select content_type_id from s09_type_ids), 50,
  jsonb_build_object('label', 'Article X conditional v50'), 'editorial', 1,
  'en-US', 'en-US', null, 'a9090000-0000-4000-8000-000000000502', repeat('c', 64),
  'conditional', 'a9090000-0000-4000-8000-000000000504',
  'a9090000-0000-4000-8000-000000000001'
);
insert into platform_private.cms_schema_artifacts(
  id, owner_id, state, version, content_type_version_id, compiler_version,
  zod_contract_ref, editor_manifest, renderer_manifest, artifact_hash, compiled_at
) values (
  'a9090000-0000-4000-8000-000000000502', (select organization_id from s09_fixture_org),
  'compiled', 1, 'a9090000-0000-4000-8000-000000000501', '1',
  'cms/content-type/articlex/v50',
  jsonb_build_object('schema', jsonb_build_object(
    'typeKey', 'articlex', 'fields', '[]'::jsonb, 'relations', '[]'::jsonb,
    'templateBindings', '[]'::jsonb, 'capabilityBindings', '[]'::jsonb
  )),
  jsonb_build_object('relations', '[]'::jsonb, 'templateBindings', '[]'::jsonb,
    'capabilityBindings', '[]'::jsonb),
  repeat('c', 64), clock_timestamp()
);
select platform_private.cms_record_dry_run_report(
  'a9090000-0000-4000-8000-000000000504',
  (select organization_id from s09_fixture_org),
  (select content_type_id from s09_type_ids),
  (select version_id from s09_type_ids),
  'a9090000-0000-4000-8000-000000000501', 'conditional',
  'cms.schema.migrate', 1,
  (select definition_hash from platform_private.cms_content_type_versions
   where id = (select version_id from s09_type_ids)),
  repeat('c', 64), repeat('c', 64), '1',
  jsonb_build_object(
    'dryRunId', 'a9090000-0000-4000-8000-000000000504', 'result', 'pass',
    'sourceHash', (select definition_hash from platform_private.cms_content_type_versions
                   where id = (select version_id from s09_type_ids)),
    'targetHash', repeat('c', 64),
    'transformKey', 'cms.schema.migrate', 'transformVersion', '1',
    'transformHash', platform_private.cms_migration_transform_hash(
      'conditional', 'cms.schema.migrate', 1,
      (select definition_hash from platform_private.cms_content_type_versions
       where id = (select version_id from s09_type_ids)),
      repeat('c', 64), repeat('c', 64), '1'
    ),
    'compilerHash', repeat('c', 64), 'compilerVersion', '1',
    'sourceCount', '2', 'targetCount', '2', 'rowErrorCount', '0',
    'migratedCount', '0', 'failedCount', '0',
    'lease', jsonb_build_object(
      'state', 'ready', 'owner', null, 'token', null,
      'expiresAt', (clock_timestamp() + interval '15 minutes')::text
    )
  ),
  'a9090000-0000-4000-8000-000000000001'
);
insert into platform_private.cms_schema_migration_plans(
  id, owner_id, state, version, content_type_id, from_version_id, to_version_id,
  classification, transform_key, transform_version, dry_run_report, cursor,
  progress, source_count, target_count, row_error_count, migrated_count,
  failed_count, created_by
) values (
  'a9090000-0000-4000-8000-000000000503', (select organization_id from s09_fixture_org),
  'ready', 1, (select content_type_id from s09_type_ids),
  (select version_id from s09_type_ids), 'a9090000-0000-4000-8000-000000000501',
  'conditional', 'cms.schema.migrate', 1,
  jsonb_build_object(
    'dryRunId', 'a9090000-0000-4000-8000-000000000504', 'result', 'pass',
    'sourceHash', (select definition_hash from platform_private.cms_content_type_versions
                   where id = (select version_id from s09_type_ids)),
    'targetHash', repeat('c', 64), 'transformKey', 'cms.schema.migrate',
    'transformVersion', '1',
    'transformHash', platform_private.cms_migration_transform_hash(
      'conditional', 'cms.schema.migrate', 1,
      (select definition_hash from platform_private.cms_content_type_versions
       where id = (select version_id from s09_type_ids)),
      repeat('c', 64), repeat('c', 64), '1'
    ),
    'compilerHash', repeat('c', 64), 'compilerVersion', '1',
    'sourceCount', '2', 'targetCount', '2', 'rowErrorCount', '0',
    'migratedCount', '0', 'failedCount', '0',
    'lease', jsonb_build_object(
      'state', 'ready', 'owner', null, 'token', null,
      -- The immutable producer report above keeps a future evidence lease.
      -- This mutable plan starts unleased so the worker can claim it; a
      -- future expiry with no owner is treated as another worker's lease.
      'expiresAt', (clock_timestamp() - interval '1 minute')::text
    )
  ), 0, 0, 2, 2, 0, 0, 0,
  'a9090000-0000-4000-8000-000000000001'
);
-- S09 has no application-content source adapter.  It must reject a non-zero
-- plan before leasing it rather than fabricate migrated counts; S10 supplies
-- the first real adapter and its independently attested source evidence.
select throws_ok(
  $$select platform_api.cms_claim_schema_migration_lease(jsonb_build_object(
    'migrationPlanId', 'a9090000-0000-4000-8000-000000000503',
    'schemaVersionId', 'a9090000-0000-4000-8000-000000000501',
    'expectedVersion', '1', 'cursor', '0', 'leaseOwner', 's09-worker-conditional',
    'workerId', 's09-worker-conditional', 'leaseDurationMs', '30000',
    'now', clock_timestamp()::text, 'transformKey', 'cms.schema.migrate',
    'transformVersion', '1', 'compilerHash', repeat('c', 64),
    'sourceHash', (select definition_hash from platform_private.cms_content_type_versions
                   where id = (select version_id from s09_type_ids)),
    'targetHash', repeat('c', 64)
  ))$$,
  'P0001', 'VALIDATION_FAILED',
  'S09 rejects non-zero migration execution without independent source evidence'
);
select ok(
  (select state = 'ready'
          and version = 1 and cursor = 0 and migrated_count = 0
          and failed_count = 0
   from platform_private.cms_schema_migration_plans
   where id = 'a9090000-0000-4000-8000-000000000503'),
  'S09 non-zero boundary leaves the migration plan unleased and unchanged'
);
