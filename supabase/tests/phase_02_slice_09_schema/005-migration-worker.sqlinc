select ok(
  (select response->>'nextCursor' is not null and response->>'nextCursor' !~ E'[\\r\\n]' from s09_cursor_page),
  'CMS-03A-06 emits a bounded newline-free opaque cursor'
);
select ok(
  (select (next_page.response->'items'->0->>'id') is distinct from (first_page.response->'items'->0->>'id')
   from s09_cursor_page first_page
   cross join lateral (
     select platform_api.cms_list_content_types(jsonb_build_object(
       'limit', 1, 'sort', 'key', 'direction', 'asc', 'cursor', first_page.response->>'nextCursor'
     )) as response
   ) next_page),
  'CMS-03A-06 advances deterministically past the cursor boundary'
);
select throws_ok(
  $$select platform_api.cms_list_content_types(jsonb_build_object(
    'limit', 1, 'sort', 'key', 'direction', 'desc',
    'cursor', (select response->>'nextCursor' from s09_cursor_page)
  ))$$,
  'P0001', 'INVALID_REQUEST',
  'CMS-03A-06 rejects a cursor reused with different sort direction or scope'
);

-- The migration-plan authority stores durable hashes and lease evidence in
-- the locked dry_run_report JSONB field; readiness is true only when every
-- hash resolves to the exact source/target/artifact currently referenced.
select set_config('app.cms_rpc', 'true', true);
insert into platform_private.cms_content_type_versions(
  id, owner_id, state, version, content_type_id, version_no, labels,
  workflow_key, workflow_version, source_locale, default_locale,
  default_template_version_id, schema_artifact_id, definition_hash,
  compatibility, dry_run_id, created_by
) values (
  'a9090000-0000-4000-8000-000000000103', (select organization_id from s09_fixture_org),
  'approved', 1, (select content_type_id from s09_type_ids), 2,
  jsonb_build_object('label', 'Article X v2'), 'editorial', 1, 'en-US', 'en-US',
  null, 'a9090000-0000-4000-8000-000000000104', repeat('b', 64), 'additive',
  'a9090000-0000-4000-8000-000000000403',
  'a9090000-0000-4000-8000-000000000001'
);
insert into platform_private.cms_schema_artifacts(
  id, owner_id, state, version, content_type_version_id, compiler_version,
  zod_contract_ref, editor_manifest, renderer_manifest, artifact_hash, compiled_at
) values (
  'a9090000-0000-4000-8000-000000000104', (select organization_id from s09_fixture_org),
  'compiled', 1, 'a9090000-0000-4000-8000-000000000103', '1',
  'cms/content-type/articlex/v2',
  jsonb_build_object(
    'schema', jsonb_build_object(
      'typeKey', 'articlex', 'label', 'Article X v2',
      'ownerCapability', 'cms.schema_designer', 'sourceLocale', 'en-US',
      'defaultLocale', 'en-US', 'workflowKey', 'editorial',
      'workflowVersion', '1', 'defaultTemplateVersionId', null,
      'fields', '[]'::jsonb, 'relations', '[]'::jsonb,
      'templateBindings', '[]'::jsonb, 'capabilityBindings', '[]'::jsonb
    ),
    'fields', '[]'::jsonb
  ),
  jsonb_build_object(
    'relations', '[]'::jsonb, 'templateBindings', '[]'::jsonb,
    'capabilityBindings', '[]'::jsonb
  ), repeat('b', 64), clock_timestamp()
);
insert into platform_private.cms_schema_migration_plans(
  id, owner_id, state, version, content_type_id, from_version_id, to_version_id,
  classification, transform_key, transform_version, dry_run_report, created_by
) values (
  'a9090000-0000-4000-8000-000000000105', (select organization_id from s09_fixture_org),
  'ready', 1, (select content_type_id from s09_type_ids),
  (select version_id from s09_type_ids), 'a9090000-0000-4000-8000-000000000103',
  'additive', null, null,
  jsonb_build_object(
    'sourceDefinitionHash', (select definition_hash from platform_private.cms_content_type_versions where id = (select version_id from s09_type_ids)),
    'targetDefinitionHash', repeat('b', 64),
    'dryRunId', 'a9090000-0000-4000-8000-000000000403',
    'transformHash', platform_private.cms_migration_transform_hash(
      'additive', null, null,
      (select definition_hash from platform_private.cms_content_type_versions where id = (select version_id from s09_type_ids)),
      repeat('b', 64), repeat('b', 64), '1'
    ),
    'compilerHash', repeat('b', 64), 'compilerVersion', '1',
    'result', 'pass',
    'sourceCount', '0', 'targetCount', '0', 'rowErrorCount', '0',
    'migratedCount', '0', 'failedCount', '0',
    'lease', jsonb_build_object('state', 'ready', 'expiresAt', (clock_timestamp() + interval '10 minutes')::text)
  ),
  'a9090000-0000-4000-8000-000000000001'
);
select ok(
  not platform_private.cms_migration_plan_ready(
    'a9090000-0000-4000-8000-000000000105',
    (select content_type_id from s09_type_ids),
    'a9090000-0000-4000-8000-000000000103'
  ),
  'S09 readiness rejects a plan before its independent producer report is persisted'
);

-- Worker activation is only a hand-off for a review already approved by a
-- human.  Seed the same immutable approval evidence that CMS-03A-04 records
-- so the service path cannot bypass the human authority boundary.
select set_config('app.cfg_rpc', 'true', true);
insert into platform_private.cfg_config_change_reviews(
  id, candidate_type, candidate_id, candidate_version, frozen_hash,
  impact_manifest, impact_manifest_hash, effective_context_hash,
  risk_class, required_approvals, state, submitted_by, submitted_at, version_no
) values (
  'a9090000-0000-4000-8000-000000000404', 'setting_value',
  'a9090000-0000-4000-8000-000000000103', 1, repeat('b', 64), '{}'::jsonb,
  platform_private.cfg_hash_json('{}'::jsonb),
  platform_private.cfg_hash_json(jsonb_build_object(
    'actingContextId', 'a9090000-0000-4000-8000-000000000090'
  )), 'high', 1,
  'review', 'a9090000-0000-4000-8000-000000000001', clock_timestamp(), 1
);
insert into platform_private.cfg_config_approvals(
  review_id, reviewer_person_id, acting_party_id, capability, decision,
  reason, reviewed_hash, decided_at, review_version
) values (
  'a9090000-0000-4000-8000-000000000404',
  'a9090000-0000-4000-8000-000000000002',
  (select organization_id from s09_fixture_org), 'cms.schema_designer',
  'approve', 'worker activation approval', repeat('b', 64), clock_timestamp(), 1
);
with approval_digest as (
  select encode(extensions.digest(convert_to(
    coalesce(jsonb_agg(jsonb_build_object(
      'reviewId', approval.review_id,
      'reviewerAuthUserId', approval.reviewer_person_id,
      'capability', approval.capability,
      'reviewedHash', approval.reviewed_hash,
      'reviewVersion', approval.review_version,
      'decidedAt', approval.decided_at
    ) order by approval.review_id, approval.reviewer_person_id)::text, '[]'),
    'utf8'
  ), 'sha256'), 'hex') as hash
  from platform_private.cfg_config_approvals approval
  where approval.review_id = 'a9090000-0000-4000-8000-000000000404'
    and approval.decision = 'approve'
    and approval.reviewed_hash = repeat('b', 64)
)
update platform_private.cms_content_type_versions candidate
set activation_workflow_policy_key = 'cms.schema.activate',
    activation_workflow_policy_version = 1,
    activation_workflow_policy_hash = encode(extensions.digest(convert_to(
      'cms.schema.activate:1:1:["cms.schema_designer"]', 'utf8'
    ), 'sha256'), 'hex'),
    activation_required_decision_count = 1,
    activation_required_capabilities = jsonb_build_array('cms.schema_designer'),
    activation_approval_evidence_hash = encode(extensions.digest(convert_to(
      jsonb_build_object(
        'key', 'cms.schema.activate', 'version', '1',
        'policyHash', encode(extensions.digest(convert_to(
          'cms.schema.activate:1:1:["cms.schema_designer"]', 'utf8'
        ), 'sha256'), 'hex'),
        'riskClass', 'ordinary',
        'requiredDecisionCount', 1,
        'requiredCapabilities', jsonb_build_array('cms.schema_designer'),
        'approvalEvidenceHash', approval_digest.hash
      )::text,
      'utf8'
    ), 'sha256'), 'hex')
from approval_digest
where candidate.id = 'a9090000-0000-4000-8000-000000000103';
update platform_private.cfg_config_change_reviews
set state = 'approved', updated_at = clock_timestamp()
where id = 'a9090000-0000-4000-8000-000000000404';

-- The worker contract is executable, not catalog-only. Exercise the full
-- service-role sequence against a zero-row plan so every transition remains
-- deterministic while proving lease/CAS, fingerprint, idempotency, event,
-- and DLQ behavior.
select set_config('request.jwt.claim.role', 'service_role', true);
select set_config('app.cms_rpc', 'true', true);
update platform_private.cms_schema_migration_plans
set state = 'draft', version = 1, cursor = 0, progress = 0,
    source_count = 0, target_count = 0, row_error_count = 0,
    migrated_count = 0, failed_count = 0, started_at = null, completed_at = null,
    dry_run_report = dry_run_report || jsonb_build_object(
      'lease', jsonb_build_object(
        'state', 'ready', 'owner', null, 'token', null,
        'expiresAt', (clock_timestamp() - interval '1 minute')::text
      )
    )
where id = 'a9090000-0000-4000-8000-000000000105';

create temp table s09_worker_plan_read on commit drop as
select platform_api.cms_get_schema_migration_plan(jsonb_build_object(
  'migrationPlanId', 'a9090000-0000-4000-8000-000000000105',
  'schemaVersionId', 'a9090000-0000-4000-8000-000000000103',
  'expectedVersion', '1'
)) as response;
select ok(
  (select response->>'id' = 'a9090000-0000-4000-8000-000000000105'
    and response->>'state' = 'draft'
    and response ?& array[
      'contentTypeId','fromVersionId','toVersionId','version','cursor','progress',
      'sourceCount','targetCount','rowErrorCount','migratedCount','failedCount',
      'classification','compilerHash','sourceHash','targetHash','activeVersionId'
    ] from s09_worker_plan_read),
  'S09 worker get-plan returns the complete durable migration-plan contract'
);

-- Model a separate PostgREST transaction: the worker RPC must open its own
-- guarded write context after service-role admission.
select set_config('app.cms_rpc', 'false', true);
create temp table s09_worker_dry_claim on commit drop as
select platform_api.cms_claim_schema_migration_lease(jsonb_build_object(
  'migrationPlanId', 'a9090000-0000-4000-8000-000000000105',
  'schemaVersionId', 'a9090000-0000-4000-8000-000000000103',
  'expectedVersion', '1', 'cursor', '0', 'leaseOwner', 's09-worker-dry',
  'workerId', 's09-worker-dry', 'leaseDurationMs', '30000',
  'now', clock_timestamp()::text, 'transformKey', null, 'transformVersion', null,
  'compilerHash', repeat('b', 64),
  'sourceHash', (select definition_hash from platform_private.cms_content_type_versions
                where id = (select version_id from s09_type_ids)),
  'targetHash', repeat('b', 64)
)) as response;
select ok(
  (select (response->>'acquired')::boolean
    and response->>'leaseToken' is not null
    and response->'plan'->>'state' = 'dry_running'
    and response->'plan'->>'version' = '2' from s09_worker_dry_claim),
  'S09 worker claim acquires a durable dry-run lease with a CAS version bump'
);
select is(
  (select response->>'renewed' from (
    select platform_api.cms_heartbeat_schema_migration_lease(jsonb_build_object(
      'migrationPlanId', 'a9090000-0000-4000-8000-000000000105',
      'expectedVersion', '2', 'cursor', '0', 'leaseToken', 'stale-token-0001',
      'workerId', 's09-worker-dry', 'now', clock_timestamp()::text,
      'leaseDurationMs', '30000'
    )) response
  ) stale),
  'false',
  'S09 worker heartbeat rejects a stale lease token without mutating the plan'
);

create temp table s09_worker_dry_batch on commit drop as
select platform_api.cms_process_schema_migration_dry_run_batch(jsonb_build_object(
  'migrationPlanId', 'a9090000-0000-4000-8000-000000000105',
  'schemaVersionId', 'a9090000-0000-4000-8000-000000000103',
  'expectedVersion', '2', 'cursor', '0', 'limit', '1',
  'leaseToken', (select response->>'leaseToken' from s09_worker_dry_claim),
  'transformKey', null, 'transformVersion', null, 'compilerHash', repeat('b', 64),
  'sourceHash', (select definition_hash from platform_private.cms_content_type_versions
                where id = (select version_id from s09_type_ids)),
  'targetHash', repeat('b', 64),
  'correlationId', 'a9090000-0000-4000-8000-000000000601', 'causationId', null
)) as response;
select ok(
  (select (response->>'done')::boolean and response->>'cursor' = '0'
    and response->>'migratedCount' = '0' from s09_worker_dry_batch),
  'S09 worker dry-run batch is bounded, cursor-safe, and complete for an empty source'
);

create temp table s09_worker_dry_final on commit drop as
select platform_api.cms_finalize_schema_migration_dry_run(jsonb_build_object(
  'migrationPlanId', 'a9090000-0000-4000-8000-000000000105',
  'expectedVersion', '2', 'cursor', '0', 'sourceCount', '0', 'targetCount', '0',
  'rowErrorCount', '0', 'transformKey', null, 'transformVersion', null,
  'compilerHash', repeat('b', 64),
  'sourceHash', (select definition_hash from platform_private.cms_content_type_versions
                where id = (select version_id from s09_type_ids)),
  'targetHash', repeat('b', 64)
)) as response;
select ok(
  (select response->>'state' = 'ready' and response->>'version' = '3'
    from s09_worker_dry_final),
  'S09 worker dry-run finalization commits ready state with a CAS version bump'
);
select ok(
  platform_private.cms_persisted_dry_run_report_valid(
    'a9090000-0000-4000-8000-000000000403',
    (select owner_id from platform_private.cms_content_type_versions
     where id = 'a9090000-0000-4000-8000-000000000103'),
    (select content_type_id from s09_type_ids),
    (select version_id from s09_type_ids),
    'a9090000-0000-4000-8000-000000000103',
    'additive', null, null,
    (select definition_hash from platform_private.cms_content_type_versions
     where id = (select version_id from s09_type_ids)),
    repeat('b', 64), repeat('b', 64), '1'
  ),
  'S09 worker finalization persists an independent immutable dry-run report'
);

create temp table s09_worker_run_claim on commit drop as
select platform_api.cms_claim_schema_migration_lease(jsonb_build_object(
  'migrationPlanId', 'a9090000-0000-4000-8000-000000000105',
  'schemaVersionId', 'a9090000-0000-4000-8000-000000000103',
  'expectedVersion', '3', 'cursor', '0', 'leaseOwner', 's09-worker-dry',
  'workerId', 's09-worker-dry', 'leaseDurationMs', '30000',
  'now', clock_timestamp()::text, 'transformKey', null, 'transformVersion', null,
  'compilerHash', repeat('b', 64),
  'sourceHash', (select definition_hash from platform_private.cms_content_type_versions
                where id = (select version_id from s09_type_ids)),
  'targetHash', repeat('b', 64)
)) as response;
select ok(
  (select (response->>'acquired')::boolean and response->'plan'->>'state' = 'running'
    and response->'plan'->>'version' = '4' from s09_worker_run_claim),
  'S09 worker claim starts the live backfill with a fresh lease and CAS'
);
select ok(
  (select (platform_api.cms_heartbeat_schema_migration_lease(jsonb_build_object(
    'migrationPlanId', 'a9090000-0000-4000-8000-000000000105',
    'expectedVersion', '4', 'cursor', '0',
    'leaseToken', response->>'leaseToken', 'workerId', 's09-worker-dry',
    'now', clock_timestamp()::text, 'leaseDurationMs', '30000'
  ))->>'renewed')::boolean from s09_worker_run_claim),
  'S09 worker heartbeat renews the live lease without changing its CAS version'
);

create temp table s09_worker_run_batch on commit drop as
select platform_api.cms_process_schema_migration_batch(jsonb_build_object(
  'migrationPlanId', 'a9090000-0000-4000-8000-000000000105',
  'schemaVersionId', 'a9090000-0000-4000-8000-000000000103',
  'expectedVersion', '4', 'cursor', '0', 'limit', '1',
  'leaseToken', (select response->>'leaseToken' from s09_worker_run_claim),
  'transformKey', null, 'transformVersion', null, 'compilerHash', repeat('b', 64),
  'sourceHash', (select definition_hash from platform_private.cms_content_type_versions
                where id = (select version_id from s09_type_ids)),
  'targetHash', repeat('b', 64),
  'correlationId', 'a9090000-0000-4000-8000-000000000602', 'causationId', null
)) as response;
select ok(
  (select (response->>'done')::boolean and response->>'cursor' = '0'
    from s09_worker_run_batch),
  'S09 worker backfill batch processes a bounded live page atomically'
);

create temp table s09_worker_verification_started on commit drop as
select platform_api.cms_begin_schema_migration_verification(jsonb_build_object(
  'migrationPlanId', 'a9090000-0000-4000-8000-000000000105',
  'expectedVersion', '4', 'cursor', '0', 'sourceCount', '0', 'targetCount', '0',
  'rowErrorCount', '0', 'migratedCount', '0', 'failedCount', '0',
  'transformKey', null, 'transformVersion', null, 'compilerHash', repeat('b', 64),
  'sourceHash', (select definition_hash from platform_private.cms_content_type_versions
                where id = (select version_id from s09_type_ids)),
  'targetHash', repeat('b', 64)
)) as response;
select ok(
  (select response->>'state' = 'verifying' and response->>'version' = '5'
    from s09_worker_verification_started),
  'S09 worker verification begin enforces zero-error counters and advances state'
);
select ok(
  (select (platform_api.cms_verify_schema_migration(jsonb_build_object(
    'migrationPlanId', 'a9090000-0000-4000-8000-000000000105',
    'schemaVersionId', 'a9090000-0000-4000-8000-000000000103',
    'expectedVersion', '5', 'cursor', '0',
    'leaseToken', (select response->>'leaseToken' from s09_worker_run_claim),
    'sourceCount', '0', 'targetCount', '0', 'rowErrorCount', '0',
    'migratedCount', '0', 'failedCount', '0', 'transformKey', null,
    'transformVersion', null, 'compilerHash', repeat('b', 64),
    'sourceHash', (select definition_hash from platform_private.cms_content_type_versions
                  where id = (select version_id from s09_type_ids)),
    'targetHash', repeat('b', 64)
  ))->>'valid')::boolean),
  'S09 worker verification proves the current fingerprints and counters'
);

create temp table s09_worker_completed on commit drop as
select platform_api.cms_complete_schema_migration(jsonb_build_object(
  'migrationPlanId', 'a9090000-0000-4000-8000-000000000105',
  'expectedVersion', '5',
  'leaseToken', (select response->>'leaseToken' from s09_worker_run_claim)
)) as response;
select ok(
  (select response->>'state' = 'completed' and response->>'version' = '6'
    from s09_worker_completed),
  'S09 worker completion persists the terminal completed plan state'
);
