-- Dead-lettering an existing outbox event is an identity-bound mutation.  A
-- queue failure may be malformed, but it must not turn an event ID into a
-- wildcard that dead-letters an unrelated row or completes another claim.
select set_config('app.cms_rpc', 'true', true);

create temp table s09_dlq_activation on commit drop as
select event.id, event.event_type, event.schema_version, event.aggregate_type,
       event.aggregate_id, event.aggregate_version, event.payload,
       event.dead_lettered_at, event.dispatched_at, event.dead_letter_reason,
       event.last_dispatch_error_code
from platform_private.outbox_events event
where event.id = (select (response->>'eventId')::uuid from s09_worker_activated);

-- Copy the committed activation payload into a second valid activation event.
-- Its distinct event ID proves the identity comparison is row-local rather
-- than accepting the first activation event that happens to share a plan.
insert into platform_private.outbox_events(
  id, event_type, schema_version, aggregate_type, aggregate_id,
  aggregate_version, correlation_id, causation_id, payload, occurred_at
)
select 'a9090000-0000-4000-8000-000000000910', event.event_type,
       event.schema_version, event.aggregate_type, event.aggregate_id,
       event.aggregate_version, 'a9090000-0000-4000-8000-000000000911',
       event.causation_id, event.payload, clock_timestamp()
from s09_dlq_activation activation
join platform_private.outbox_events event on event.id = activation.id;

create temp table s09_dlq_second_activation on commit drop as
select event.id, event.event_type, event.schema_version, event.aggregate_type,
       event.aggregate_id, event.aggregate_version, event.payload
from platform_private.outbox_events event
where event.id = 'a9090000-0000-4000-8000-000000000910';

select is(
  (select response->>'status' from (
    select platform_api.cms_claim_schema_migration_event(jsonb_build_object(
      'eventId', id, 'eventType', event_type, 'schemaVersion', schema_version,
      'aggregateType', aggregate_type, 'aggregateId', aggregate_id,
      'aggregateVersion', aggregate_version::text,
      'migrationPlanId', payload->'migrationPlanId',
      'claimToken', 'a9090000-0000-4000-8000-000000000912', 'replay', false
    )) response
    from s09_dlq_second_activation
  ) claim),
  'new',
  'S09 DLQ identity regression claims the second valid activation event'
);

select throws_ok(
  $$select platform_api.cms_dead_letter_schema_migration_event(jsonb_build_object(
    'eventId', id, 'eventType', event_type, 'schemaVersion', schema_version,
    'aggregateType', aggregate_type, 'aggregateId', aggregate_id,
    'aggregateVersion', aggregate_version::text,
    'claimToken', 'a9090000-0000-4000-8000-000000000912',
    'reasonCode', 'MISSING_IDENTITY'
  )) from s09_dlq_second_activation$$,
  'P0001', 'CONFLICT',
  'S09 DLQ rejects an existing event when canonical identity is absent'
);
select ok(
  (select dead_lettered_at is null and dispatched_at is null
      and dead_letter_reason is null and last_dispatch_error_code is null
   from platform_private.outbox_events
   where id = 'a9090000-0000-4000-8000-000000000910'),
  'S09 DLQ missing-identity rejection leaves the second event unchanged'
);
select is(
  (select state::text from platform_private.idempotency_records
   where actor_id = 'a9090000-0000-4000-8000-000000000910'
     and operation = 'cms.schema.event.claim'
     and key_hash = platform_private.cms_key_hash('a9090000-0000-4000-8000-000000000910')),
  'reserved',
  'S09 DLQ missing-identity rejection leaves the second event claim reserved'
);

select throws_ok(
  $$select platform_api.cms_dead_letter_schema_migration_event(jsonb_build_object(
    'eventId', second.id, 'eventType', second.event_type,
    'schemaVersion', second.schema_version, 'aggregateType', second.aggregate_type,
    'aggregateId', unrelated.aggregate_id,
    'aggregateVersion', second.aggregate_version::text,
    'migrationPlanId', second.payload->'migrationPlanId',
    'claimToken', 'a9090000-0000-4000-8000-000000000912',
    'reasonCode', 'MISMATCHED_IDENTITY'
  ))
  from s09_dlq_second_activation second
  cross join platform_private.outbox_events unrelated
  where unrelated.id = 'a9090000-0000-4000-8000-000000000107'$$,
  'P0001', 'CONFLICT',
  'S09 DLQ rejects an existing event when aggregate identity mismatches'
);
select ok(
  (select dead_lettered_at is null and dispatched_at is null
      and dead_letter_reason is null and last_dispatch_error_code is null
   from platform_private.outbox_events
   where id = 'a9090000-0000-4000-8000-000000000910'),
  'S09 DLQ mismatched identity rejection leaves the second event unchanged'
);
select is(
  (select state::text from platform_private.idempotency_records
   where actor_id = 'a9090000-0000-4000-8000-000000000910'
     and operation = 'cms.schema.event.claim'
     and key_hash = platform_private.cms_key_hash('a9090000-0000-4000-8000-000000000910')),
  'reserved',
  'S09 DLQ mismatched identity rejection leaves the second event claim reserved'
);

-- aggregate_type remains advisory for compatibility with the two existing
-- activation producers; all other canonical identity fields still match.
select is(
  (select platform_api.cms_dead_letter_schema_migration_event(jsonb_build_object(
    'eventId', id, 'eventType', event_type, 'schemaVersion', schema_version,
    'aggregateType', 'legacy.activation.fixture', 'aggregateId', aggregate_id,
    'aggregateVersion', aggregate_version::text,
    'migrationPlanId', payload->'migrationPlanId',
    'claimToken', 'a9090000-0000-4000-8000-000000000912',
    'reasonCode', 'WORKER_FAILURE'
  ))->>'accepted' from s09_dlq_second_activation),
  'true',
  'S09 DLQ accepts a valid activation event with advisory aggregate type'
);
select ok(
  (select event_type = 'cms.schema.activated.v1' and schema_version = 1
      and dead_lettered_at is not null and dispatched_at is not null
      and dead_letter_reason = 'WORKER_FAILURE'
      and last_dispatch_error_code = 'WORKER_FAILURE'
   from platform_private.outbox_events
   where id = 'a9090000-0000-4000-8000-000000000910'),
  'S09 DLQ persists the exact second activation row only after identity validation'
);
select is(
  (select state::text from platform_private.idempotency_records
   where actor_id = 'a9090000-0000-4000-8000-000000000910'
     and operation = 'cms.schema.event.claim'
     and key_hash = platform_private.cms_key_hash('a9090000-0000-4000-8000-000000000910')),
  'failed_retryable',
  'S09 DLQ releases only the matching second activation claim for replay'
);

-- Event 107 is a different existing outbox row with the same migration-plan
-- payload.  Supplying the second activation's identity must not mutate it.
select is(
  (select response->>'status' from (
    select platform_api.cms_claim_schema_migration_event(jsonb_build_object(
      'eventId', 'a9090000-0000-4000-8000-000000000107',
      'eventType', event_type, 'schemaVersion', schema_version,
      'aggregateType', aggregate_type, 'aggregateId', aggregate_id,
      'aggregateVersion', aggregate_version::text,
      'migrationPlanId', payload->'migrationPlanId',
      'claimToken', 'a9090000-0000-4000-8000-000000000913', 'replay', false
    )) response
    from platform_private.outbox_events
    where id = 'a9090000-0000-4000-8000-000000000107'
  ) claim),
  'new',
  'S09 DLQ identity regression claims the unrelated outbox row'
);
select throws_ok(
  $$select platform_api.cms_dead_letter_schema_migration_event(jsonb_build_object(
    'eventId', 'a9090000-0000-4000-8000-000000000107',
    'eventType', activation.event_type, 'schemaVersion', activation.schema_version,
    'aggregateType', activation.aggregate_type, 'aggregateId', activation.aggregate_id,
    'aggregateVersion', activation.aggregate_version::text,
    'migrationPlanId', activation.payload->'migrationPlanId',
    'claimToken', 'a9090000-0000-4000-8000-000000000913',
    'reasonCode', 'UNRELATED_ROW'
  )) from s09_dlq_activation activation$$,
  'P0001', 'CONFLICT',
  'S09 DLQ rejects an unrelated existing outbox row instead of mutating by ID'
);
select ok(
  (select dead_lettered_at is null and dispatched_at is null
      and dead_letter_reason is null and last_dispatch_error_code is null
   from platform_private.outbox_events
   where id = 'a9090000-0000-4000-8000-000000000107'),
  'S09 DLQ unrelated-row rejection leaves the row unchanged'
);
select is(
  (select state::text from platform_private.idempotency_records
   where actor_id = 'a9090000-0000-4000-8000-000000000107'
     and operation = 'cms.schema.event.claim'
     and key_hash = platform_private.cms_key_hash('a9090000-0000-4000-8000-000000000107')),
  'reserved',
  'S09 DLQ unrelated-row rejection leaves the unrelated claim reserved'
);
